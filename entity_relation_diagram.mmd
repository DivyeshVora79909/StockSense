%% StockSense - Normalised Inventory Management Graph
%% Save this file as graph.mmd
%% STOCK_BALANCE is a current-state projection; STOCK_MOVE is the immutable stock ledger.

erDiagram
    ROLE {
        string role_code PK
        string role_name
    }

    USER {
        string user_id PK
        string role_code FK
        string full_name
        string email
        string password_hash
        bool is_active
        datetime created_at
    }

    AUTH_OTP {
        string otp_id PK
        string user_id FK
        string purpose
        string code_hash
        datetime expires_at
        datetime consumed_at
    }

    WAREHOUSE {
        string warehouse_id PK
        string warehouse_code
        string warehouse_name
        bool is_active
    }

    LOCATION_TYPE {
        string location_type_code PK
        string type_name
    }

    LOCATION {
        string location_id PK
        string warehouse_id FK
        string location_type_code FK
        string location_code
        string location_name
        bool is_active
    }

    PRODUCT_CATEGORY {
        string category_id PK
        string category_name
    }

    UNIT_OF_MEASURE {
        string uom_id PK
        string uom_code
        string uom_name
    }

    PRODUCT {
        string product_id PK
        string sku
        string product_name
        string category_id FK
        string uom_id FK
        string description
        bool is_active
        datetime created_at
    }

    REORDER_RULE {
        string reorder_rule_id PK
        string product_id FK
        string location_id FK
        decimal min_qty
        decimal reorder_qty
        decimal max_qty
        int lead_time_days
    }

    SUPPLIER {
        string supplier_id PK
        string supplier_code
        string supplier_name
    }

    CUSTOMER {
        string customer_id PK
        string customer_code
        string customer_name
    }

    DOCUMENT_STATUS {
        string status_code PK
        string status_name
    }

    MOVE_TYPE {
        string move_type_code PK
        string move_type_name
    }

    REFERENCE_TYPE {
        string reference_type_code PK
        string reference_type_name
    }

    RECEIPT {
        string receipt_id PK
        string receipt_number
        string supplier_id FK
        string destination_location_id FK
        string status_code FK
        string created_by FK
        datetime scheduled_at
        datetime validated_at
    }

    RECEIPT_LINE {
        string receipt_line_id PK
        string receipt_id FK
        string product_id FK
        decimal qty_expected
        decimal qty_received
    }

    DELIVERY_ORDER {
        string delivery_id PK
        string delivery_number
        string customer_id FK
        string source_location_id FK
        string status_code FK
        string created_by FK
        datetime scheduled_at
        datetime validated_at
    }

    DELIVERY_LINE {
        string delivery_line_id PK
        string delivery_id FK
        string product_id FK
        decimal qty_ordered
        decimal qty_reserved
        decimal qty_done
    }

    INTERNAL_TRANSFER {
        string transfer_id PK
        string transfer_number
        string source_location_id FK
        string destination_location_id FK
        string status_code FK
        string created_by FK
        datetime scheduled_at
        datetime validated_at
    }

    TRANSFER_LINE {
        string transfer_line_id PK
        string transfer_id FK
        string product_id FK
        decimal qty_requested
        decimal qty_moved
    }

    STOCK_ADJUSTMENT {
        string adjustment_id PK
        string adjustment_number
        string location_id FK
        string status_code FK
        string reason
        string created_by FK
        datetime counted_at
        datetime validated_at
    }

    ADJUSTMENT_LINE {
        string adjustment_line_id PK
        string adjustment_id FK
        string product_id FK
        decimal system_qty
        decimal counted_qty
        decimal variance_qty
    }

    STOCK_MOVE {
        string move_id PK
        datetime move_at
        string product_id FK
        string source_location_id FK
        string destination_location_id FK
        decimal qty
        string move_type_code FK
        string reference_type_code FK
        string reference_id
        string reference_line_id
        string created_by FK
    }

    STOCK_BALANCE {
        string product_id PK
        string location_id PK
        decimal qty_on_hand
        decimal qty_reserved
        datetime updated_at
    }

    STOCK_ALERT {
        string alert_id PK
        string product_id FK
        string location_id FK
        string alert_type
        datetime created_at
        datetime resolved_at
    }

    ROLE ||--o{ USER : has
    USER ||--o{ AUTH_OTP : requests

    WAREHOUSE ||--o{ LOCATION : contains
    LOCATION_TYPE ||--o{ LOCATION : classifies

    PRODUCT_CATEGORY ||--o{ PRODUCT : classifies
    UNIT_OF_MEASURE ||--o{ PRODUCT : measures

    PRODUCT ||--o{ REORDER_RULE : has
    LOCATION ||--o{ REORDER_RULE : applies_to

    SUPPLIER ||--o{ RECEIPT : supplies
    LOCATION ||--o{ RECEIPT : receives_into
    DOCUMENT_STATUS ||--o{ RECEIPT : controls
    USER ||--o{ RECEIPT : creates
    RECEIPT ||--|{ RECEIPT_LINE : contains
    PRODUCT ||--o{ RECEIPT_LINE : includes

    CUSTOMER ||--o{ DELIVERY_ORDER : requests
    LOCATION ||--o{ DELIVERY_ORDER : picks_from
    DOCUMENT_STATUS ||--o{ DELIVERY_ORDER : controls
    USER ||--o{ DELIVERY_ORDER : creates
    DELIVERY_ORDER ||--|{ DELIVERY_LINE : contains
    PRODUCT ||--o{ DELIVERY_LINE : includes

    LOCATION ||--o{ INTERNAL_TRANSFER : sources
    LOCATION ||--o{ INTERNAL_TRANSFER : destinations
    DOCUMENT_STATUS ||--o{ INTERNAL_TRANSFER : controls
    USER ||--o{ INTERNAL_TRANSFER : creates
    INTERNAL_TRANSFER ||--|{ TRANSFER_LINE : contains
    PRODUCT ||--o{ TRANSFER_LINE : includes

    LOCATION ||--o{ STOCK_ADJUSTMENT : counts
    DOCUMENT_STATUS ||--o{ STOCK_ADJUSTMENT : controls
    USER ||--o{ STOCK_ADJUSTMENT : creates
    STOCK_ADJUSTMENT ||--|{ ADJUSTMENT_LINE : contains
    PRODUCT ||--o{ ADJUSTMENT_LINE : adjusts

    PRODUCT ||--o{ STOCK_MOVE : moves
    LOCATION ||--o{ STOCK_MOVE : leaves_from
    LOCATION ||--o{ STOCK_MOVE : enters_into
    MOVE_TYPE ||--o{ STOCK_MOVE : classifies
    REFERENCE_TYPE ||--o{ STOCK_MOVE : references
    USER ||--o{ STOCK_MOVE : posts

    PRODUCT ||--o{ STOCK_BALANCE : holds
    LOCATION ||--o{ STOCK_BALANCE : stores

    PRODUCT ||--o{ STOCK_ALERT : triggers
    LOCATION ||--o{ STOCK_ALERT : triggers